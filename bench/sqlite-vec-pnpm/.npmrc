# Mirrors only (GitHub unreachable in this dev network, M0 ADR §1): electron
# binaries and better-sqlite3 prebuilds come from npmmirror. Keys are the
# same ones the repo-root .npmrc sets for the workspace; repeated here so the
# sandbox stays standalone (pnpm does not apply the root workspace settings).
electron_mirror=https://registry.npmmirror.com/-/binary/electron/
better_sqlite3_binary_host_mirror=https://registry.npmmirror.com/-/binary/better-sqlite3
