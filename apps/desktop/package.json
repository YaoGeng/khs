{
  "name": "@xinglian/desktop",
  "private": true,
  "version": "0.1.0",
  "main": "out/main.js",
  "scripts": {
    "lint": "eslint .",
    "build": "node -e \"fs.rmSync('out',{recursive:true,force:true})\" && esbuild src/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=out/main.js && node -e \"fs.mkdirSync('out',{recursive:true});fs.cpSync('src/index.html','out/index.html')\"",
    "dist": "npm run build && node scripts/dist.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "electron": "^33",
    "electron-builder": "^25",
    "esbuild": "^0.28.2"
  }
}
